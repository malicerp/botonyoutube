<!DOCTYPE html>
<html><head><meta charset="utf-8">
<style>
html,body{margin:0;height:100%;background:transparent;overflow:hidden}
#b{position:relative;width:100%;height:100%;box-sizing:border-box;background:#13151b;border:1px solid #2e323d;border-radius:2px;overflow:hidden;cursor:pointer;color:#e8ecf7}
#t{position:absolute;inset:0;background:center/cover no-repeat;filter:grayscale(1);opacity:.35;transform:scale(1.25)}
#i{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;opacity:.9}
svg{width:14px;height:14px;fill:currentColor}
#pa{display:none}
#p{position:absolute;left:-400px;top:0;width:200px;height:200px}
</style></head><body>
<div id="b"><div id="t"></div><div id="i">
<svg id="pl" viewBox="0 0 24 24"><path d="M8 5.5v13l10.5-6.5z"/></svg>
<svg id="pa" viewBox="0 0 24 24"><path d="M7 5h4v14H7zM13 5h4v14h-4z"/></svg>
</div></div>
<div id="p"></div>
<script src="https://www.youtube.com/iframe_api"></script>
<script>
var id=new URLSearchParams(location.search).get('v'), pl;
document.getElementById('t').style.backgroundImage='url(https://i.ytimg.com/vi/'+id+'/mqdefault.jpg)';
function show(on){
  document.getElementById('pl').style.display=on?'none':'block';
  document.getElementById('pa').style.display=on?'block':'none';
}
function onYouTubeIframeAPIReady(){
  pl=new YT.Player('p',{width:200,height:200,videoId:id,
    playerVars:{controls:0,playsinline:1},
    events:{onStateChange:function(e){show(e.data===1);}}});
}
document.getElementById('b').onclick=function(){
  if(!pl||!pl.getPlayerState)return;
  pl.getPlayerState()===1?pl.pauseVideo():pl.playVideo();
};
</script>
</body></html>
